# HUGGINGFACE_API_KEY / HF_TOKEN: Token for Hugging Face inference models (e.g. Llama 3.2 3B)
HUGGINGFACE_API_KEY=""
HF_TOKEN=""
HF_MODEL="meta-llama/Llama-3.2-3B-Instruct"

# GEMINI_API_KEY: Optional - enables Gemini AI models for tutoring, Q&A, and notice analysis.
# When omitted, BrailleBridge AI runs 100% offline using deterministic rule-based engines.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
# Required for cloud synchronization of study plans, notes, notices, and game progress.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public Anon Key from Supabase Dashboard -> Project Settings -> API.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional backend admin key for server-side persistence.
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Client-accessible environment variables
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
